# .env.example — copy to .env and fill in. The signal process reads these.
# Do NOT commit the real .env (see .gitignore).

# --- Trading Supabase project (NEW project, separate from CausaView) ---
# Direct Postgres connection string for the service-role / superuser. Used by
# asyncpg. NOT the anon key — this is a headless backend.
TRADING_DB_URL=postgresql://postgres:PASSWORD@db.YOURPROJECT.supabase.co:5432/postgres

# --- Sumtyme ---
SUMTYME_API_KEY=your-sumtyme-key

# --- Kafka (this system's own broker on the trading box) ---
KAFKA_BOOTSTRAP=localhost:9092
# Bar ingress topic — deliberately NOT 'raw-prices' (that's CausaView's).
TRADING_BARS_TOPIC=trading-bars
# Tagged chain-event output topic.
CHAIN_EVENTS_TOPIC=chain-events
# Consumer group for the signal process's bar consumer.
SIGNAL_CONSUMER_GROUP=signal-process-group

# --- Position-manager process (later; not needed for signals) ---
# IBKR_ACCOUNT=
# IBKR_USERNAME=        # dedicated bot username (so a manual TWS login can't evict it)
# IB_GATEWAY_HOST=127.0.0.1
# IB_GATEWAY_PORT=4002
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
