# .env.example — every environment variable read by the four processes
# (warmup_process, feed_process, signal_process, run_executor).
#
# Copy to .env and fill in. .env is gitignored and dockerignored; docker-compose
# injects it at runtime via env_file. Never commit real values.
#
# Defaults shown are the in-code defaults; a commented-out line means "leave
# unset to use the default".

# --- Shared ------------------------------------------------------------------
# Supabase/Postgres DSN. Required by signal_process and run_executor; warmup and
# feed use it for warmup_bars / feed_cursors and degrade without it.
TRADING_DB_URL=postgresql://user:password@host:6543/postgres
# Inside compose this is overridden to kafka:9092.
# KAFKA_BOOTSTRAP=localhost:9092
# TRADING_BARS_TOPIC=trading-bars
# LOG_LEVEL=INFO

# --- warmup_process ----------------------------------------------------------
# WARMUP_MAX_CONCURRENT=8

# --- signal_process ----------------------------------------------------------
# Required.
SUMTYME_API_KEY=
# Polygon (equities, PR 9). Required by feed, warmup AND signal (rule1's vol filter)
# when ASSET_CONFIGS has an equity entry.
POLYGON_API_KEY=
# RESEARCH_BARS_INTERVAL_S=900   # research process: 1m-bar collection cadence
# POLYGON_WS_HOST=business.polygon.io   # the real-time entitlement host; socket.polygon.io denies real-time
# CHAIN_EVENTS_TOPIC=chain-events
# SIGNAL_CONSUMER_GROUP=signal-process-group
# SYMBOL_QUEUE_MAX=1000
# SYMBOL_INFLIGHT_MAX=4      # one symbol's max concurrent forecasts (< FORECAST_CONCURRENCY)
# COMMIT_INTERVAL_S=5.0
# LAG_WARN_S=300
# Health/audit endpoint port (compose-internal only; never published).
# HEALTH_PORT=8081
# AUDIT_REFRESH_S=60
# SUMTYME_TIMEOUT_S=20
# FORECAST_CONCURRENCY=6
# THREAD_POOL_SIZE=16

# --- run_executor ------------------------------------------------------------
# EXECUTOR_VENUE=coinbase
# Seconds a refused/failed boot waits before exiting (bounds the compose restart loop).
# EXECUTOR_BOOT_RETRY_S=300
# Coinbase Advanced Trade CDP API key, created ON the dedicated bot portfolio
# (ADR-001 Phase 4). Requirements, enforced at connect():
#   * signature algorithm ECDSA (Coinbase rejects Ed25519 keys for this API);
#   * scoped to the bot portfolio only (COINBASE_PORTFOLIO_UUID);
#   * permissions View + Trade, and NOT Transfer.
# Check it with: python verify_coinbase_readonly.py   (read-only, no orders)
# COINBASE_API_KEY_NAME=organizations/<org-id>/apiKeys/<key-id>
# The PEM private key on ONE line with literal \n escapes, quoted:
# COINBASE_API_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n"
# COINBASE_PORTFOLIO_UUID=
# COINBASE_BASE_URL=https://api.coinbase.com/api/v3/brokerage

# --- tests -------------------------------------------------------------------
# Real-Postgres integration tests are skipped unless this is set.
# QISS_TEST_DSN=postgresql://...
